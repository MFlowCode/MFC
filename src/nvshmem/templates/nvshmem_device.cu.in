namespace {

// Tiered P2P copy to a peer-mapped destination. The stores are vectorized to 16 or 8
// bytes when both pointers are aligned and stay on SMs, which keeps them capture-safe.
// Shared by the 26-halo and the IB force puts.
__device__ __forceinline__ void p2p_copy_vec(void *dst_raw, const void *src_raw, size_t len) {
    char *dst = static_cast<char *>(dst_raw);
    const char *src = static_cast<const char *>(src_raw);
    const int tid = static_cast<int>(threadIdx.x);
    const int nthr = static_cast<int>(blockDim.x);

    const uintptr_t a16 = reinterpret_cast<uintptr_t>(dst) | reinterpret_cast<uintptr_t>(src);
    if ((a16 & 0xF) == 0) {
        uint4 *d4 = reinterpret_cast<uint4 *>(dst);
        const uint4 *s4 = reinterpret_cast<const uint4 *>(src);
        const size_t n4 = len >> 4;
        for (size_t i = tid; i < n4; i += nthr) d4[i] = s4[i];
        for (size_t i = (n4 << 4) + tid; i < len; i += nthr) dst[i] = src[i];
    } else if ((a16 & 0x7) == 0) {
        unsigned long long *d8 = reinterpret_cast<unsigned long long *>(dst);
        const unsigned long long *s8 = reinterpret_cast<const unsigned long long *>(src);
        const size_t n8 = len >> 3;
        for (size_t i = tid; i < n8; i += nthr) d8[i] = s8[i];
        for (size_t i = (n8 << 3) + tid; i < len; i += nthr) dst[i] = src[i];
    } else {
        for (size_t i = tid; i < len; i += nthr) dst[i] = src[i];
    }
}

#if @with_halo_26@
constexpr int halo_26_channel_count = @halo_26_channel_count@;
constexpr int halo_26_max_neighbors = @halo_26_max_neighbors@;
#ifdef MFC_SINGLE_PRECISION
using halo_put_type = float;
#else
using halo_put_type = double;
#endif

__constant__ int c_dst_pe[halo_26_max_neighbors];
__constant__ int c_channel[halo_26_max_neighbors];
__constant__ long long c_src_points[halo_26_max_neighbors];
__constant__ long long c_dst_points[halo_26_max_neighbors];
__constant__ long long c_point_count[halo_26_max_neighbors];

__device__ std::uint64_t *d_ready = nullptr;
__device__ std::uint64_t *d_consumed = nullptr;

int configured_neighbors = 0;

__device__ __forceinline__ int signal_26(const int parity, const int channel) {
    return parity * halo_26_channel_count + channel;
}
__global__ void k_flowctl_26(const unsigned long long epoch) {
    const int parity = static_cast<int>(epoch & 1ULL);
    nvshmem_signal_wait_until(&d_consumed[signal_26(parity, c_channel[blockIdx.x])], NVSHMEM_CMP_GE, epoch - 2);
}
__global__ void k_wait_26(const unsigned long long epoch) {
    const int parity = static_cast<int>(epoch & 1ULL);
    nvshmem_signal_wait_until(&d_ready[signal_26(parity, c_channel[blockIdx.x])], NVSHMEM_CMP_GE, epoch);
}

__global__ void k_complete_26(const int neighbor_count, const unsigned long long epoch) {
    const int n = threadIdx.x;
    if (n >= neighbor_count) return;

    const int parity = static_cast<int>(epoch & 1ULL);
    nvshmemx_signal_op(&d_consumed[signal_26(parity, halo_26_channel_count - 1 - c_channel[n])], epoch,
                       NVSHMEM_SIGNAL_SET, c_dst_pe[n]);
}

// Signal kernel for the split path (signal_needs_split in the host backend). The host
// puts, makes the puts remotely visible on the stream, then runs this kernel.
__global__ void k_signal_26(const int neighbor_count, const unsigned long long epoch) {
    const int n = threadIdx.x;
    if (n >= neighbor_count) return;

    const int parity = static_cast<int>(epoch & 1ULL);
    nvshmemx_signal_op(&d_ready[signal_26(parity, halo_26_channel_count - 1 - c_channel[n])], epoch,
                       NVSHMEM_SIGNAL_SET, c_dst_pe[n]);
}
// Device-resident epoch exchange (MFC_HALO_EPOCH_DEVICE). The epoch counter, its parity,
// and the receive base live in device memory so every launch of an exchange issues
// identical kernel parameters and the whole stage is CUDA-graph capturable. k_advance_26
// is the one writer of d_epoch_26; the _dev kernels are its readers.
__device__ unsigned long long d_epoch_26 = 0;
__device__ unsigned long long *d_recv_base_26 = nullptr;
__device__ long long d_inbox_elements_26 = 0;
// Per-parity count of data-only put slices that have copied. k_put_26_dev splits every
// neighbor's run across put_slices blocks; the last non-empty slice of the exchange spins
// on this flag and only then issues the signal, preserving the putmem_signal
// data-before-signal ordering. k_advance_26 resets the flag of the parity it activates,
// which is safe because that parity's previous exchange signaled (all its slices copied)
// two epochs ago.
__device__ unsigned long long d_put_done_26[2] = {0, 0};
constexpr int put_slices = 8;

__global__ void k_advance_26() {
    const unsigned long long epoch = d_epoch_26 + 1ULL;
    const int parity = static_cast<int>(epoch & 1ULL);
    if (threadIdx.x == 0) d_put_done_26[parity] = 0;
    __syncthreads();
    d_epoch_26 = epoch;
    *d_recv_base_26 = (epoch & 1ULL) * static_cast<unsigned long long>(d_inbox_elements_26);
}
__global__ void k_flowctl_26_dev() {
    const unsigned long long epoch = d_epoch_26;
    if (epoch <= 2ULL) return;
    const int parity = static_cast<int>(epoch & 1ULL);
    nvshmem_signal_wait_until(&d_consumed[signal_26(parity, c_channel[blockIdx.x])], NVSHMEM_CMP_GE, epoch - 2);
}

__global__ void k_put_26_dev(halo_put_type *inbox, const long long inbox_elements, const halo_put_type *src,
                             const long long v_size) {
    const int neighbors = static_cast<int>(gridDim.x / put_slices);
    const int n = static_cast<int>(blockIdx.x / put_slices);
    const int slice = static_cast<int>(blockIdx.x % put_slices);
    const unsigned long long epoch = d_epoch_26;
    const int parity = static_cast<int>(epoch & 1ULL);

    const size_t total = static_cast<size_t>(v_size * c_point_count[n]) * sizeof(halo_put_type);
    const int non_empty = static_cast<int>(total < static_cast<size_t>(put_slices) ? total
                                                                                    : put_slices);
    // A zero-count neighbor still owes its channel a signal, so slice 0 signals for it.
    const int sig_slice = non_empty == 0 ? 0 : non_empty - 1;
    if (slice > sig_slice) return;
    const size_t off = total * static_cast<size_t>(slice) / put_slices;
    const size_t len = total * static_cast<size_t>(slice + 1) / put_slices - off;

    // The symmetric-heap address (the caller's own inbox layout) resolves to the peer's
    // mapping; when the fabric is not P2P-reachable there is no local mapping and every
    // slice falls back to NVSHMEM's own puts, which are correct on every fabric.
    halo_put_type *dst_sym = inbox + static_cast<long long>(parity) * inbox_elements + v_size * c_dst_points[n];
    const char *s = reinterpret_cast<const char *>(src + v_size * c_src_points[n]) + off;
    char *d = reinterpret_cast<char *>(dst_sym) + off;
    void *peer = nvshmem_ptr(dst_sym, c_dst_pe[n]);
    std::uint64_t *ready = &d_ready[signal_26(parity, halo_26_channel_count - 1 - c_channel[n])];

    // Data movement. P2P slices take the vectorized stores here; the signal slice and a
    // non-P2P data slice defer their bytes to the puts below.
    if (len > 0 && peer != nullptr) {
        p2p_copy_vec(static_cast<char *>(peer) + off, s, len);
    } else if (len > 0 && slice != sig_slice) {
        // Thread-scoped like the signal slice below, since the per-thread quiet must cover
        // the put, and it does not wait out block-scoped ops.
        if (threadIdx.x == 0) nvshmem_putmem_nbi(d, s, len, c_dst_pe[n]);
    }
    __syncthreads();

    if (slice == sig_slice) {
        // Wait for every data-only slice of this exchange before signaling. The expected
        // count sums, over all neighbors, the non-final non-empty slices.
        unsigned long long expected = 0;
        for (int m = 0; m < neighbors; ++m) {
            const size_t mt = static_cast<size_t>(v_size * c_point_count[m]) * sizeof(halo_put_type);
            const int me = static_cast<int>(mt < static_cast<size_t>(put_slices) ? mt : put_slices);
            expected += static_cast<unsigned long long>(me > 0 ? me - 1 : 0);
        }
        if (threadIdx.x == 0) {
            while (atomicAdd(&d_put_done_26[parity], 0ULL) < expected) __nanosleep(128);
            // Put, quiet to remote completion, then signal: the combined put+signal op does not
            // order the signal after remote data visibility on every transport.
            if (peer != nullptr) {
                __threadfence_system();
                nvshmemx_signal_op(ready, epoch, NVSHMEM_SIGNAL_SET, c_dst_pe[n]);
            } else {
                nvshmem_putmem_nbi(d, s, len, c_dst_pe[n]);
                nvshmem_quiet();
                __threadfence_system();
                nvshmemx_signal_op(ready, epoch, NVSHMEM_SIGNAL_SET, c_dst_pe[n]);
            }
        }
    } else if (len > 0) {
        // A data slice flags completion after its bytes are remotely visible. The
        // vectorized stores need the system fence and a non-P2P put needs the quiet.
        if (threadIdx.x == 0) {
            if (peer != nullptr) __threadfence_system();
            else nvshmem_quiet();
            atomicAdd(&d_put_done_26[parity], 1ULL);
        }
    }
}
__global__ void k_wait_26_dev() {
    const int n = blockIdx.x;
    const unsigned long long epoch = d_epoch_26;
    const int parity = static_cast<int>(epoch & 1ULL);
    nvshmem_signal_wait_until(&d_ready[signal_26(parity, c_channel[n])], NVSHMEM_CMP_GE, epoch);
}
__global__ void k_complete_26_dev(const int neighbor_count) {
    const int n = threadIdx.x;
    if (n >= neighbor_count) return;

    const unsigned long long epoch = d_epoch_26;
    const int parity = static_cast<int>(epoch & 1ULL);
    nvshmemx_signal_op(&d_consumed[signal_26(parity, halo_26_channel_count - 1 - c_channel[n])], epoch,
                       NVSHMEM_SIGNAL_SET, c_dst_pe[n]);
}
#endif
