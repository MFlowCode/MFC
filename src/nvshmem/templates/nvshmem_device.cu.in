__global__ void k_signal_wait(std::uint64_t *sig_addr, const unsigned long long cmp_value) {
    nvshmem_signal_wait_until(sig_addr, NVSHMEM_CMP_GE, cmp_value);
}

__global__ void k_signal_set(std::uint64_t *sig_addr, const unsigned long long value, const int pe) {
    nvshmemx_signal_op(sig_addr, value, NVSHMEM_SIGNAL_SET, pe);
}

// Owner-based IB force exchange (s_communicate_ib_forces) with the batched wait and
// signal kernels the halo exchange uses, over a device-resident neighbor PE list so
// one launch covers every peer. The pack and fold kernels live on the Fortran side.
int *ib_force_pes_buf = nullptr;
void **ib_force_inbox_peer_buf = nullptr;
int configured_ib_force = 0;
__device__ int *d_ib_force_pes = nullptr;
__device__ void **d_ib_force_inbox_peer = nullptr;
__device__ std::uint64_t *d_ready_ib_force = nullptr;
__device__ std::uint64_t *d_consumed_ib_force = nullptr;

__global__ void k_flowctl_ib_force(const int phase, const int num_pes, const unsigned long long epoch) {
    const int parity = static_cast<int>(epoch & 1ULL);
    nvshmem_signal_wait_until(&d_consumed_ib_force[(2 * phase + parity) * num_pes + d_ib_force_pes[blockIdx.x]],
                              NVSHMEM_CMP_GE, epoch - 2);
}
__global__ void k_wait_ib_force(const int phase, const int num_pes, const unsigned long long epoch) {
    const int parity = static_cast<int>(epoch & 1ULL);
    nvshmem_signal_wait_until(&d_ready_ib_force[(2 * phase + parity) * num_pes + d_ib_force_pes[blockIdx.x]],
                              NVSHMEM_CMP_GE, epoch);
}
__global__ void k_signal_ib_force(const int count, const int phase, const int my_pe, const int num_pes,
                                  const unsigned long long epoch) {
    const int parity = static_cast<int>(epoch & 1ULL);
    for (int n = threadIdx.x; n < count; n += blockDim.x)
        nvshmemx_signal_op(&d_ready_ib_force[(2 * phase + parity) * num_pes + my_pe], epoch, NVSHMEM_SIGNAL_SET,
                           d_ib_force_pes[n]);
}
__global__ void k_complete_ib_force(const int count, const int phase, const int my_pe, const int num_pes,
                                    const unsigned long long epoch) {
    const int parity = static_cast<int>(epoch & 1ULL);
    for (int n = threadIdx.x; n < count; n += blockDim.x)
        nvshmemx_signal_op(&d_consumed_ib_force[(2 * phase + parity) * num_pes + my_pe], epoch,
                           NVSHMEM_SIGNAL_SET, d_ib_force_pes[n]);
}
// One kernel ships this phase's slot to every neighbor, since the host-enqueued put+signal
// op synchronizes the host against the compute queue. Each neighbor's destination is its
// host-resolved nvshmem_ptr mapping, configured once above. Every slot is split across
// ib_force_put_slices blocks, and the signal follows from the separate signal kernel once
// this one completes. Unmapped peers take a thread-scoped device-issued put from the first
// slice, whose own quiet covers it.
constexpr int ib_force_put_slices = 8;

__global__ void k_put_ib_force(const void *send, void *inbox, const long long slot_bytes, const int phase,
                               const int my_pe, const int num_pes, const unsigned long long epoch) {
    const int n = blockIdx.x / ib_force_put_slices;
    const int slice = blockIdx.x % ib_force_put_slices;
    const int parity = static_cast<int>(epoch & 1ULL);
    const int dst_pe = d_ib_force_pes[n];
    char *dst_sym = static_cast<char *>(inbox) +
                    (static_cast<long long>(my_pe) * 4 + 2 * phase + parity) * slot_bytes;
    const char *src = static_cast<const char *>(send) +
                      (static_cast<long long>(phase) * num_pes + dst_pe) * slot_bytes;
    char *dst = static_cast<char *>(d_ib_force_inbox_peer[n]);

    if (dst != nullptr) {
        dst += (static_cast<long long>(my_pe) * 4 + 2 * phase + parity) * slot_bytes;
        const long long chunk = (slot_bytes + ib_force_put_slices - 1) / ib_force_put_slices;
        const long long beg = static_cast<long long>(slice) * chunk;
        long long end = beg + chunk;
        if (end > slot_bytes) end = slot_bytes;
        if (beg < end) {
            p2p_copy_vec(dst + beg, src + beg, static_cast<size_t>(end - beg));
            // Kernel completion alone does not fence peer-mapped writes system-wide, so
            // every storing thread fences before the signal kernel behind this one runs.
            __threadfence_system();
        }
    } else if (slice == 0 && threadIdx.x == 0) {
        nvshmem_putmem_nbi(dst_sym, src, slot_bytes, dst_pe);
        nvshmem_quiet();
    }
}

}
extern "C" int mfc_nvshmem_device_init(void *mpi_comm) {
    nvshmemx_init_attr_t attr = NVSHMEMX_INIT_ATTR_INITIALIZER;
    attr.mpi_comm = mpi_comm;
    return nvshmemx_init_attr(NVSHMEMX_INIT_WITH_MPI_COMM, &attr);
}

extern "C" void mfc_nvshmem_device_finalize() {
    nvshmem_finalize();
}

#if @with_halo_26@
extern "C" int mfc_nvshmem_device_bind_26(void *ready, void *consumed) {
    if (cudaMemcpyToSymbol(d_ready, &ready, sizeof(ready)) != cudaSuccess) return -1;
    if (cudaMemcpyToSymbol(d_consumed, &consumed, sizeof(consumed)) != cudaSuccess) return -1;
    return 0;
}

extern "C" int mfc_nvshmem_device_configure_26(const int neighbor_count, const int *dst_pe, const int *channel,
                                               const long long *src_points, const long long *dst_points,
                                               const long long *point_count, cudaStream_t stream) {
    if (neighbor_count < 0 || neighbor_count > halo_26_max_neighbors) return -1;

    // Stream-ordered symbol writes, since the reconfigure may run while an in-flight exchange
    // (e.g. a whole-stage CUDA-graph replay enqueued before it) still reads the previous
    // trim. Issued on the caller's compute stream, the new tables take effect only after
    // that work completes, and the next exchange's launches on the same stream see the new
    // tables. The sources are pageable host buffers, so the staged copy of their contents
    // completes before this returns.
    const std::size_t ints = static_cast<std::size_t>(neighbor_count) * sizeof(int);
    if (cudaMemcpyToSymbolAsync(c_dst_pe, dst_pe, ints, 0, cudaMemcpyHostToDevice, stream) != cudaSuccess) return -2;
    if (cudaMemcpyToSymbolAsync(c_channel, channel, ints, 0, cudaMemcpyHostToDevice, stream) != cudaSuccess) return -2;

    const std::size_t lls = static_cast<std::size_t>(neighbor_count) * sizeof(long long);
    if (cudaMemcpyToSymbolAsync(c_src_points, src_points, lls, 0, cudaMemcpyHostToDevice, stream) != cudaSuccess) return -2;
    if (cudaMemcpyToSymbolAsync(c_dst_points, dst_points, lls, 0, cudaMemcpyHostToDevice, stream) != cudaSuccess) return -2;
    if (cudaMemcpyToSymbolAsync(c_point_count, point_count, lls, 0, cudaMemcpyHostToDevice, stream) != cudaSuccess) return -2;

    configured_neighbors = neighbor_count;
    return 0;
}

extern "C" int mfc_nvshmem_device_launch_flowctl_26(const unsigned long long epoch, void *stream) {
    if (configured_neighbors == 0) return -1;

    k_flowctl_26<<<configured_neighbors, 1, 0, static_cast<cudaStream_t>(stream)>>>(epoch);
    return cudaGetLastError() == cudaSuccess ? 0 : -2;
}

extern "C" int mfc_nvshmem_device_launch_wait_26(const unsigned long long epoch, void *stream) {
    if (configured_neighbors == 0) return -1;

    k_wait_26<<<configured_neighbors, 1, 0, static_cast<cudaStream_t>(stream)>>>(epoch);
    return cudaGetLastError() == cudaSuccess ? 0 : -2;
}

extern "C" int mfc_nvshmem_device_launch_complete_26(const unsigned long long epoch, void *stream) {
    if (configured_neighbors == 0) return -1;

    k_complete_26<<<1, halo_26_max_neighbors, 0, static_cast<cudaStream_t>(stream)>>>(configured_neighbors, epoch);
    return cudaGetLastError() == cudaSuccess ? 0 : -2;
}

extern "C" int mfc_nvshmem_device_launch_signal_26(const unsigned long long epoch, void *stream) {
    if (configured_neighbors == 0) return 0;

    k_signal_26<<<1, halo_26_max_neighbors, 0, static_cast<cudaStream_t>(stream)>>>(configured_neighbors, epoch);
    return cudaGetLastError() == cudaSuccess ? 0 : -2;
}

extern "C" int mfc_nvshmem_device_bind_epoch_26(unsigned long long *recv_base, const long long inbox_elements) {
    const unsigned long long zero = 0;
    if (cudaMemcpyToSymbol(d_epoch_26, &zero, sizeof(zero)) != cudaSuccess) return -1;
    if (cudaMemcpyToSymbol(d_recv_base_26, &recv_base, sizeof(recv_base)) != cudaSuccess) return -2;
    if (cudaMemcpyToSymbol(d_inbox_elements_26, &inbox_elements, sizeof(inbox_elements)) != cudaSuccess) return -3;
    return 0;
}

extern "C" int mfc_nvshmem_device_launch_advance_26(void *stream) {
    k_advance_26<<<1, 1, 0, static_cast<cudaStream_t>(stream)>>>();
    return cudaGetLastError() == cudaSuccess ? 0 : -2;
}
extern "C" int mfc_nvshmem_device_launch_flowctl_26_dev(void *stream) {
    if (configured_neighbors == 0) return -1;

    k_flowctl_26_dev<<<configured_neighbors, 1, 0, static_cast<cudaStream_t>(stream)>>>();
    return cudaGetLastError() == cudaSuccess ? 0 : -2;
}
extern "C" int mfc_nvshmem_device_launch_put_26_dev(void *inbox, const long long inbox_elements, const void *src,
                                                    const long long v_size, void *stream) {
    if (configured_neighbors == 0) return -1;

    k_put_26_dev<<<configured_neighbors * put_slices, 256, 0, static_cast<cudaStream_t>(stream)>>>(
        static_cast<halo_put_type *>(inbox), inbox_elements, static_cast<const halo_put_type *>(src), v_size);
    return cudaGetLastError() == cudaSuccess ? 0 : -2;
}
extern "C" int mfc_nvshmem_device_launch_wait_26_dev(void *stream) {
    if (configured_neighbors == 0) return -1;

    k_wait_26_dev<<<configured_neighbors, 1, 0, static_cast<cudaStream_t>(stream)>>>();
    return cudaGetLastError() == cudaSuccess ? 0 : -2;
}
extern "C" int mfc_nvshmem_device_launch_complete_26_dev(void *stream) {
    if (configured_neighbors == 0) return -1;

    k_complete_26_dev<<<1, halo_26_max_neighbors, 0, static_cast<cudaStream_t>(stream)>>>(configured_neighbors);
    return cudaGetLastError() == cudaSuccess ? 0 : -2;
}

#endif
#if @with_igr@
extern "C" int mfc_nvshmem_device_bind_igr(void *ready, void *consumed) {
    if (cudaMemcpyToSymbol(d_ready_igr, &ready, sizeof(ready)) != cudaSuccess) return -1;
    if (cudaMemcpyToSymbol(d_consumed_igr, &consumed, sizeof(consumed)) != cudaSuccess) return -1;
    return 0;
}

extern "C" int mfc_nvshmem_device_configure_igr(const int active_count, const int *dst_pe, const int *face) {
    if (active_count < 0 || active_count > igr_face_count) return -1;

    if (active_count > 0) {
        const std::size_t ints = static_cast<std::size_t>(active_count) * sizeof(int);
        if (cudaMemcpyToSymbol(c_igr_dst_pe, dst_pe, ints) != cudaSuccess) return -2;
        if (cudaMemcpyToSymbol(c_igr_face, face, ints) != cudaSuccess) return -2;
    }

    configured_igr_faces = active_count;
    return 0;
}
extern "C" int mfc_nvshmem_device_launch_flowctl_igr(const unsigned long long epoch, void *stream) {
    if (configured_igr_faces == 0) return 0;

    k_flowctl_igr<<<configured_igr_faces, 1, 0, static_cast<cudaStream_t>(stream)>>>(epoch);
    return cudaGetLastError() == cudaSuccess ? 0 : -2;
}

