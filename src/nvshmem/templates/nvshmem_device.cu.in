    if (configured_igr_faces == 0) return 0;

    k_wait_igr<<<configured_igr_faces, 1, 0, static_cast<cudaStream_t>(stream)>>>(epoch);
    return cudaGetLastError() == cudaSuccess ? 0 : -2;
}

extern "C" int mfc_nvshmem_device_launch_complete_igr(const unsigned long long epoch, void *stream) {
    if (configured_igr_faces == 0) return 0;

    k_complete_igr<<<1, igr_face_count, 0, static_cast<cudaStream_t>(stream)>>>(configured_igr_faces, epoch);
    return cudaGetLastError() == cudaSuccess ? 0 : -2;
}

extern "C" int mfc_nvshmem_device_launch_signal_igr_faces(const unsigned long long epoch, void *stream) {
    if (configured_igr_faces == 0) return 0;

    k_signal_igr_faces<<<1, igr_face_count, 0, static_cast<cudaStream_t>(stream)>>>(configured_igr_faces, epoch);
    return cudaGetLastError() == cudaSuccess ? 0 : -2;
}
#endif
extern "C" int mfc_nvshmem_device_launch_signal_wait(void *sig_addr, const unsigned long long cmp_value,
                                                    void *stream) {
    k_signal_wait<<<1, 1, 0, static_cast<cudaStream_t>(stream)>>>(static_cast<std::uint64_t *>(sig_addr),
                                                                 cmp_value);
    return cudaGetLastError() == cudaSuccess ? 0 : -2;
