__constant__ int c_igr_dst_pe[igr_face_count];
__constant__ int c_igr_face[igr_face_count];

__device__ std::uint64_t *d_ready_igr = nullptr;
__device__ std::uint64_t *d_consumed_igr = nullptr;

int configured_igr_faces = 0;

__device__ __forceinline__ int signal_igr(const int parity, const int face) {
    return parity * igr_face_count + face;
}

__global__ void k_flowctl_igr(const unsigned long long epoch) {
    const int parity = static_cast<int>(epoch & 1ULL);
    nvshmem_signal_wait_until(&d_consumed_igr[signal_igr(parity, c_igr_face[blockIdx.x])], NVSHMEM_CMP_GE, epoch - 2);
}

__global__ void k_wait_igr(const unsigned long long epoch) {
    const int parity = static_cast<int>(epoch & 1ULL);
    nvshmem_signal_wait_until(&d_ready_igr[signal_igr(parity, c_igr_face[blockIdx.x])], NVSHMEM_CMP_GE, epoch);
