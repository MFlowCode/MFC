// Signalling split from the data put, like k_signal_26. Put, stream-ordered quiet, then
// this kernel, so the signal cannot precede remote data visibility on any transport.
__global__ void k_signal_igr_faces(const int active_count, const unsigned long long epoch) {
    const int n = threadIdx.x;
    if (n >= active_count) return;

