extern "C" int mfc_nvshmem_device_configure_ib_force(const int count, const int *pes, void **inbox_peer,
                                                     const int num_pes, std::uint64_t *ready,
                                                     std::uint64_t *consumed) {
    if (count < 0 || count > num_pes) return -1;
    if (ib_force_pes_buf != nullptr) {
        cudaFree(ib_force_pes_buf);
        ib_force_pes_buf = nullptr;
    }
    if (ib_force_inbox_peer_buf != nullptr) {
        cudaFree(ib_force_inbox_peer_buf);
        ib_force_inbox_peer_buf = nullptr;
    }
    if (count > 0) {
        const std::size_t ints = static_cast<std::size_t>(count) * sizeof(int);
        const std::size_t ptrs = static_cast<std::size_t>(count) * sizeof(void *);
        if (cudaMalloc(&ib_force_pes_buf, ints) != cudaSuccess) return -2;
        if (cudaMalloc(&ib_force_inbox_peer_buf, ptrs) != cudaSuccess) return -3;
        if (cudaMemcpy(ib_force_pes_buf, pes, ints, cudaMemcpyHostToDevice) != cudaSuccess) return -4;
        if (cudaMemcpy(ib_force_inbox_peer_buf, inbox_peer, ptrs, cudaMemcpyHostToDevice) != cudaSuccess) return -5;
        if (cudaMemcpyToSymbol(d_ib_force_pes, &ib_force_pes_buf, sizeof(ib_force_pes_buf)) != cudaSuccess) return -6;
        if (cudaMemcpyToSymbol(d_ib_force_inbox_peer, &ib_force_inbox_peer_buf, sizeof(ib_force_inbox_peer_buf)) !=
            cudaSuccess)
            return -7;
    }
    if (cudaMemcpyToSymbol(d_ready_ib_force, &ready, sizeof(ready)) != cudaSuccess) return -8;
    if (cudaMemcpyToSymbol(d_consumed_ib_force, &consumed, sizeof(consumed)) != cudaSuccess) return -9;
    configured_ib_force = count;
    return 0;
}

extern "C" void mfc_nvshmem_device_free_ib_force() {
    if (ib_force_pes_buf != nullptr) {
        cudaFree(ib_force_pes_buf);
        ib_force_pes_buf = nullptr;
    }
    if (ib_force_inbox_peer_buf != nullptr) {
        cudaFree(ib_force_inbox_peer_buf);
        ib_force_inbox_peer_buf = nullptr;
    }
    configured_ib_force = 0;
}

extern "C" int mfc_nvshmem_device_launch_flowctl_ib_force(const int phase, const int num_pes,
                                                          const unsigned long long epoch, void *stream) {
    if (configured_ib_force == 0) return -1;

    k_flowctl_ib_force<<<configured_ib_force, 1, 0, static_cast<cudaStream_t>(stream)>>>(phase, num_pes, epoch);
    return cudaGetLastError() == cudaSuccess ? 0 : -2;
}

extern "C" int mfc_nvshmem_device_launch_wait_ib_force(const int phase, const int num_pes,
                                                       const unsigned long long epoch, void *stream) {
    if (configured_ib_force == 0) return -1;

    k_wait_ib_force<<<configured_ib_force, 1, 0, static_cast<cudaStream_t>(stream)>>>(phase, num_pes, epoch);
    return cudaGetLastError() == cudaSuccess ? 0 : -2;
}

extern "C" int mfc_nvshmem_device_launch_signal_ib_force(const int count, const int phase, const int my_pe,
                                                         const int num_pes, const unsigned long long epoch,
                                                         void *stream) {
    if (configured_ib_force == 0) return 0;

    k_signal_ib_force<<<1, 256, 0, static_cast<cudaStream_t>(stream)>>>(count, phase, my_pe, num_pes, epoch);
    return cudaGetLastError() == cudaSuccess ? 0 : -2;
}

extern "C" int mfc_nvshmem_device_launch_complete_ib_force(const int count, const int phase, const int my_pe,
                                                           const int num_pes, const unsigned long long epoch,
                                                           void *stream) {
    if (configured_ib_force == 0) return 0;

    k_complete_ib_force<<<1, 256, 0, static_cast<cudaStream_t>(stream)>>>(count, phase, my_pe, num_pes, epoch);
    return cudaGetLastError() == cudaSuccess ? 0 : -2;
}

extern "C" int mfc_nvshmem_device_launch_put_ib_force(const void *send, void *inbox,
                                                      const unsigned long long slot_bytes, const int phase,
                                                      const int my_pe, const int num_pes,
                                                      const unsigned long long epoch, void *stream) {
    if (configured_ib_force == 0) return -1;

    k_put_ib_force<<<configured_ib_force * ib_force_put_slices, 128, 0,
                     static_cast<cudaStream_t>(stream)>>>(send, inbox, static_cast<long long>(slot_bytes), phase,
                                                          my_pe, num_pes, epoch);
    return cudaGetLastError() == cudaSuccess ? 0 : -2;
}

// Host-API memcpys reject some OpenACC-pool device ranges as sources while kernel
// loads and stores reach them, so the staging fallback copies through this kernel.
__global__ void k_stage_copy(double *__restrict__ dst, const double *__restrict__ src,
                             const unsigned long long n) {
    const unsigned long long stride = (unsigned long long)blockDim.x * gridDim.x;
    for (unsigned long long idx = (unsigned long long)blockIdx.x * blockDim.x + threadIdx.x; idx < n;
         idx += stride)
        dst[idx] = src[idx];
}

extern "C" int mfc_nvshmem_device_stage_copy(void *dst, const void *src, const unsigned long long bytes,
                                             void *stream) {
    const unsigned long long n = bytes / sizeof(double);
    const int block = 256;
    const unsigned long long grid = (n + block - 1) / block;
    k_stage_copy<<<grid > 0 ? (unsigned)grid : 1u, block, 0, static_cast<cudaStream_t>(stream)>>>(
        static_cast<double *>(dst), static_cast<const double *>(src), n);
    return cudaGetLastError() == cudaSuccess ? 0 : -2;
}
