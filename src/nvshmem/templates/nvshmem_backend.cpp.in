// Startup IB-patch neighborhood exchange with plain symmetric puts ordered by quiet and
// barrier. It runs once per run, outside the per-exchange channel/epoch machinery. The
// counts buffer holds each PE's patch count, and the inbox holds one variable-size
// packed patch record per distinct neighbor slot.
int *ib_patch_counts = nullptr;
std::uint64_t *ib_patch_signal = nullptr;
std::uint8_t *ib_patch_inbox = nullptr;
std::uint8_t *ib_patch_stage = nullptr;
std::uint8_t *ib_patch_scalar_stage = nullptr;
std::size_t ib_patch_slot_bytes = 0;
std::size_t ib_patch_stage_bytes = 0;
int ib_patch_num_pes = 0;
std::uint64_t ib_patch_seq = 0;
bool initialized_ib_patch_counts = false;
bool initialized_ib_patch_inbox = false;

// Owner-based IB force exchange (s_communicate_ib_forces). Every PE holds one
// [src PE][phase][parity] inbox slot of fixed-size records plus a symmetric send
// buffer, one slot per phase per owner rank, so the Fortran pack kernel indexes a
// slot by owner rank alone. A record is 7 words (gbl_patch_id, negative for no
// record and zero for never written, then force(1:3) and torque(1:3)) at the sender's
// patch_ib slot index, so a full slot ships every phase with no sizing or
// compaction round. Per-phase epochs with consumed-signal backpressure pace slot
// reuse, the same double buffering the halo channels use. Signals live on the
// word owner. A writer signals the reader's ready word, the reader releases the
// writer's consumed word, both indexed by the far end's PE. The neighbor PE list
// is device-resident (mfc_nvshmem_device_configure_ib_force) so one kernel waits
// or signals every peer, the halo exchange's batched shape.
igr_value_type *ib_force_inbox = nullptr;
igr_value_type *ib_force_send = nullptr;
std::uint64_t *ib_force_ready = nullptr;
std::uint64_t *ib_force_consumed = nullptr;
std::vector<int> ib_force_pes;
std::size_t ib_force_slot_words = 0;
std::size_t ib_force_send_slots = 0;
int ib_force_num_pes = 0;
bool initialized_ib_force = false;

}

