namespace {

constexpr int halo_channel_count = @halo_channel_count@;
constexpr int slots_per_channel = 2;
constexpr int halo_slot_count = halo_channel_count * slots_per_channel;
#ifdef MFC_ASYNC_QUEUE
constexpr long openacc_queue = 1L;
#else
constexpr long openacc_queue = acc_async_sync;
#endif

#ifdef MFC_SINGLE_PRECISION
using halo_value_type = float;
#else
using halo_value_type = double;
#endif

halo_value_type *halo_inbox = nullptr;
std::uint64_t *ready = nullptr;
std::uint64_t *consumed = nullptr;
std::size_t slot_elements = 0;
std::array<std::uint64_t, halo_channel_count> send_epoch{};
std::array<std::uint64_t, halo_channel_count> recv_epoch{};
bool initialized = false;

bool valid_channel(const int channel) {
    return channel >= 0 && channel < halo_channel_count;
}
// Retirement needs a flush, which releases the source buffer for the next pack; each
// exchange's own quiet provides remote visibility before the signal. NVSHMEM releases
// before 3.7 lack flush_on_stream and use the stronger quiet.
#if defined(NVSHMEM_VENDOR_MAJOR_VERSION) &&                                                       \
    (NVSHMEM_VENDOR_MAJOR_VERSION > 3 || (NVSHMEM_VENDOR_MAJOR_VERSION == 3 && NVSHMEM_VENDOR_MINOR_VERSION >= 7))
void retire_puts(cudaStream_t stream) { nvshmemx_flush_on_stream(stream); }
#else
void retire_puts(cudaStream_t stream) { nvshmemx_quiet_on_stream(stream); }
#endif

// Under ibgda the combined put+signal op can release its signal before the data is
// remotely visible, so ibgda runs put, quiet the stream, and signal from a separate
// kernel. The RC transport and P2P deliver the signal behind the data and keep the
// combined op.
static bool signal_needs_split() {
    static const bool split = [] {
        const char *transport = getenv("NVSHMEM_REMOTE_TRANSPORT");
        const char *ibgda = getenv("NVSHMEM_IB_ENABLE_IBGDA");
        return (transport != nullptr && strcmp(transport, "ibgda") == 0) ||
               (ibgda != nullptr && strcmp(ibgda, "1") == 0);
    }();
    return split;
}

// The RDMA transports put from registered buffers, so each caller send buffer is
// registered once on first use. When the registration of an OpenACC pool buffer is
// refused, the buffer is staged through a registered cudaMalloc mirror on the same
// stream.
constexpr int registered_source_max = 8;
const void *registered_sources[registered_source_max] = {};
struct staged_source {
    const void *src;
    void *mirror;
    std::size_t bytes;
};
staged_source staged_sources[registered_source_max] = {};

int ensure_source_registered(const void *buffer, const std::size_t bytes) {
    if (buffer == nullptr || bytes == 0) return 0;
    for (int i = 0; i < registered_source_max; ++i)
        if (registered_sources[i] == buffer) return 0;
    for (int i = 0; i < registered_source_max; ++i)
        if (staged_sources[i].src == buffer) return 0;
    if (nvshmemx_buffer_register(const_cast<void *>(buffer), bytes) == 0) {
        for (int i = 0; i < registered_source_max; ++i) {
            if (registered_sources[i] == nullptr) {
                registered_sources[i] = buffer;
                return 0;
            }
        }
        nvshmemx_buffer_unregister(const_cast<void *>(buffer));
        return -2;
    }
    // On a refused registration, fall back to a cudaMalloc'd, always-registrable mirror.
    fprintf(stderr, "mfc: nvshmem refused to register a send buffer (%zu B); staging via mirror\n", bytes);
    void *mirror = nullptr;
    if (cudaMalloc(&mirror, bytes) != cudaSuccess || mirror == nullptr) return -3;
    if (nvshmemx_buffer_register(mirror, bytes) != 0) {
        cudaFree(mirror);
        return -4;
    }
    for (int i = 0; i < registered_source_max; ++i) {
        if (staged_sources[i].src == nullptr) {
            staged_sources[i] = {buffer, mirror, bytes};
            return 0;
        }
    }
    return -5;
}

// Returns the pointer the puts read from, the caller buffer when it registered and
// otherwise its mirror refreshed on the stream. The refresh is a kernel copy in the
// device TU (mfc_nvshmem_device.cu) because the runtime memcpy API rejects some
// OpenACC-pool device ranges as sources.
extern "C" int mfc_nvshmem_device_stage_copy(void *dst, const void *src, unsigned long long bytes,
                                             void *stream);

const void *put_source(const void *buffer, const std::size_t bytes, cudaStream_t stream) {
    for (int i = 0; i < registered_source_max; ++i) {
        if (staged_sources[i].src == buffer) {
            if (mfc_nvshmem_device_stage_copy(staged_sources[i].mirror, buffer, bytes, stream) != 0)
                return nullptr;
            return staged_sources[i].mirror;
        }
    }
    return buffer;
}

int halo_slot(const int channel, const std::uint64_t epoch) {
    return slots_per_channel * channel + static_cast<int>(epoch % slots_per_channel);
}

#ifdef MFC_HALO_SINGLE_ROUND
