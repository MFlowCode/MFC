igr_value_type *igr_inbox = nullptr;
std::uint64_t *ready_igr = nullptr;
std::uint64_t *consumed_igr = nullptr;
std::size_t igr_elements = 0;
// The send buffer holds this rank's local face total, while igr_elements is the
// symmetric-slot maximum over ranks, so registration and staging use the local extent.
std::size_t igr_send_extent = 0;
std::uint64_t epoch_igr = 0;
bool initialized_igr = false;

int igr_active_count = 0;
std::array<int, igr_face_count> igr_dst_pe{};
std::array<int, igr_face_count> igr_face{};
std::array<long long, igr_face_count> igr_src_off{};
std::array<long long, igr_face_count> igr_dst_off{};
std::array<long long, igr_face_count> igr_count{};

