halo_value_type *halo_26_inbox = nullptr;
std::uint64_t *ready_26 = nullptr;
std::uint64_t *consumed_26 = nullptr;
std::size_t halo_26_elements = 0;
std::uint64_t epoch_26 = 0;
bool initialized_26 = false;
constexpr int halo_26_max_neighbors = @halo_26_max_neighbors@;
int neighbor_count_26 = 0;
std::array<int, halo_26_max_neighbors> dst_pe_26{};
std::array<int, halo_26_max_neighbors> channel_26{};
std::array<long long, halo_26_max_neighbors> src_points_26{};
std::array<long long, halo_26_max_neighbors> dst_points_26{};
std::array<long long, halo_26_max_neighbors> point_count_26{};

int signal_26(const int parity, const int channel) {
    return parity * halo_26_channel_count + channel;
}
#endif
